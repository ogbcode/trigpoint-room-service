# Port the server listens on
PORT=
# Log level for the server logs, e.g. info or debug
LOG_LEVEL=
# Public HTTPS address of this server. Paystack returns guests here and Chord calls the tools here, e.g. https://your-app.up.railway.app
SERVER_URL=
# Postgres connection string, e.g. postgres://user:password@localhost:5432/trigpoint
DATABASE_URL=
# Long random secret. Chord sends it with every tool call, and the server rejects calls without it
CHORD_TOOLS_TOKEN=
# Password for the kitchen, bar and front desk board at /board. The username is not checked
BOARD_PASSWORD=
# Paystack test secret key (starts with sk_test_). Live keys are refused
PAYSTACK_SECRET_KEY=
# Chord API key, used only by npm run chord:setup
CHORD_API_KEY=
# Chord workspace the teammate lives in, used only by npm run chord:setup
CHORD_WORKSPACE_ID=
